<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template: DAILY warehouse refresh (P3).

  *** NOT INSTALLED. This file is a template only; nothing loads it. ***
  Enabling a schedule is an explicit operator action (see below), and the
  refresh itself still serialises against manual runs via the MySQL lock
  (a collision exits 3 and does nothing).

  To enable (macOS):
    1. Replace __REPO_PATH__ everywhere in this file with the absolute
       path to this repository, e.g. via:
         sed "s|__REPO_PATH__|$PWD|g" \
           scripts/launchd/com.aviation.dw.refresh.plist.template \
           > ~/Library/LaunchAgents/com.aviation.dw.refresh.plist
    2. launchctl load ~/Library/LaunchAgents/com.aviation.dw.refresh.plist
    3. Verify: launchctl list | grep aviation.dw.refresh

  To disable again:
    launchctl unload ~/Library/LaunchAgents/com.aviation.dw.refresh.plist
    rm ~/Library/LaunchAgents/com.aviation.dw.refresh.plist

  Notes:
  - Runs every day at 03:00 (adjust StartCalendarInterval).
  - Output and exit codes land in logs/ (per-run file created by the
    wrapper; StandardOutPath catches launchd-level messages only).
  - The wrapper + orchestrator never print credentials; logs are
    git-ignored.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.aviation.dw.refresh</string>

    <key>ProgramArguments</key>
    <array>
      <string>__REPO_PATH__/scripts/scheduled_refresh.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <!-- a still-running previous run makes this launch exit 3 (locked) -->
    <key>ThrottleInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>__REPO_PATH__/logs/launchd_refresh.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_PATH__/logs/launchd_refresh.err</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
  </dict>
</plist>
